# Local secrets and configuration
.env
.env.*
!.env.example
.claude/settings.local.json
# Python and tooling caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# Node / build / runtime output
node_modules/
dist/
build/
*.egg-info/
.tmp/
var/
# Generated local skill discovery copies; canonical sources are skills/
.agents/skills/aetp-protocol-navigation/
.agents/skills/aetp-execution-contracts/
.agents/skills/aetp-evidence-handoff/
# Reasonix local runtime artefacts (session traces + local-only skills)
.reasonix/
# Historical review scratch directories under evidence/ (temp/tmp* scratch,
# not formal evidence); some are OS permission-locked and unreadable, which
# would otherwise abort `git add`.
Docs/development/evidence/**/temp/
Docs/development/evidence/**/tmp/

# Historical evidence run output: the per-run files sitting directly under
# Docs/development/evidence/ are superseded drafts and intermediate run
# directories (review-runs/, *-input-blobs/, fixtures/) from earlier sessions.
# None of them is read by tools/devprep.py, which works from fixed paths only.
# The accepted evidence for every work item is tracked and stays visible below;
# anything new that does belong in evidence must be `git add -f`-ed explicitly.
Docs/development/evidence/*
!Docs/development/evidence/preparation-report.json
!Docs/development/evidence/environment.json
!Docs/development/evidence/devprep-check.json
!Docs/development/evidence/knowledge-graph-check.json
!Docs/development/evidence/backlog-check.json
!Docs/development/evidence/preparation-log.md
