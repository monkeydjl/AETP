  "test_methods": {
    "tests/m3/test_integration_live.py": [
      "test_real_receipt_declaration_changes_only_project_and_has_no_execution",
      "test_supersession_preserves_prior_version_and_task",
      "test_missing_copied_wrong_authority_and_wrong_command_receipts_reject",
      "test_current_human_owner_required_and_actor_mismatch_not_persisted",
      "test_project_and_task_revisions_checked_in_writer",
      "test_exemption_blocks_declaration_and_required_blocks_legacy_configuration",
      "test_declaring_does_not_require_author_execution_session",
      "test_paused_project_rejects_declaration",
      "test_original_retry_and_reopened_connection_skip_authority_clock_and_evaluator",
      "test_rejected_retry_keeps_original_result_even_after_valid_proof",
      "test_gate_must_be_entered_before_writer",
      "test_old_handler_refuses_declaration_with_replayable_project_audits",
      "test_merge_never_executes_and_distinguishes_missing_stale_and_unavailable",
      "test_merge_checks_owner_revision_and_base_legacy_handler_too",
      "test_missing_and_foreign_targets_remain_typed_rejections_and_replayable",
      "test_receipt_does_not_survive_authority_replacement_or_changed_governance_revision"
    ],
    "tests/m3/test_integration_live_concurrency.py": [
      "test_domain_event_failure_rolls_back_command_receipt_result_and_same_key_retry",
      "test_result_failure_rolls_back_every_fact_and_same_key_can_succeed",
      "test_merge_rejection_result_failure_also_rolls_back",
      "test_lost_response_returns_saved_declaration_without_new_authority_or_clock",
      "test_two_processes_same_project_revision_commit_one_declaration",
      "test_two_processes_declaration_and_exemption_cannot_both_commit",
      "test_task_revision_committed_before_writer_invalidates_declaration",
      "test_declaration_before_quality_completion_is_fail_closed",
      "test_completed_task_cannot_later_gain_requirement",
      "test_declaration_receipt_cannot_interleave_a_quality_compound",
      "test_deleted_cache_reopen_and_readonly_recovery_use_facts_without_runtime",
      "test_corrupt_cache_cannot_erase_registry_on_next_writer"
    ],
    "tests/m3/test_integration_live_replay.py": [
      "test_every_prefix_rebuild_and_pending_are_pure",
      "test_receipt_revision_address_digest_and_scope_are_bound",
      "test_effect_identity_scope_and_causation_are_bound",
      "test_exact_envelope_schema_index_count_and_json_types",
      "test_full_record_and_resealed_history_cannot_be_forged",
      "test_context_and_command_cannot_change_under_same_receipt",
      "test_missing_and_duplicate_receipts_and_second_terminal_fail",
      "test_merge_receipt_cannot_have_a_declaration_success",
      "test_rejection_address_revision_and_exact_typed_error",
      "test_supported_schema_is_forbidden_in_audit_and_unrelated_domain",
      "test_non_declaration_project_effect_cannot_erase_history",
      "test_cursor_failure_after_reduction_publishes_nothing",
      "test_cached_state_never_replaces_causal_history",
      "test_full_store_command_comparison_rejects_changed_original",
      "test_full_store_rejection_expected_revision_matches_original_command"
    ]
  },
