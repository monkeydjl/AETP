        "fresh_demo_v1"
      ]
    },
    {
      "criterion": "Versioned evidence applicability without legacy promotion",
      "tests": [
        "test_task_quality_evidence.py",
        "test_task_quality_boundaries.py"
      ],
      "decision": "accepted",
      "assessment": "Evidence use binds the versioned cycle and complete Artifact set before applicability is evaluated. Expired or invalid records cannot be hidden by fresher results. PASSED plus pending/lost/error INCONCLUSIVE remains IN_REVIEW. Valid historical results remain usable after the actual QA Task ends, its Session disappears, and dispatch TTL expires, subject to current evidence-use policy and age limits.",
      "run_labels": [
        "suite_m3_v1",
        "probes_v1",
        "fresh_demo_v1"
      ]
    },
    {
      "criterion": "Explicit Task-specific exemption and terminal execution retirement",
      "tests": [
        "test_task_quality_lifecycle.py"
      ],
      "decision": "accepted",
      "assessment": "COMPLETED is demonstrated only for the specific human_owner declaration for t-1 as standalone_fixed_json_document. Completion retires the author execution and Lease, while both COMPLETED and CANCELLED reject old-entry resurrection. Copying a Session object does not create an author capability. Withdrawal or relevant revision changes prevent stale completion.",
      "run_labels": [
        "suite_m3_v1",
        "probes_v1",
        "fresh_demo_v1"
      ]
    },
    {
      "criterion": "Atomic/retry/race integrity and pure old/new Replay",
      "tests": [
        "test_task_quality_replay.py",
        "test_task_quality_concurrency.py"
      ],
      "decision": "accepted",
      "assessment": "SQLite rollback, retries, response loss, separate-connection races, strict causal receipt/cursor validation, and both completion effects were checked. The independent first-effect failure leaves no partial receipt or pending Command and can retry. Every prefix of ten frozen old/new databases plus two new independent databases rebuilds without guarded execution or I/O and without changing database bytes.",
      "run_labels": [
        "suite_m3_v1",
        "suite_m2_v1",
        "suite_m1_v1",
        "suite_m0_v1",
        "probes_v1",
